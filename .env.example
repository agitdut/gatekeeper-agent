# Gatekeeper agent — environment template. Copy to .env and fill in.
# NEVER commit a filled .env.

# Required: one-time plaintext from Agent Games dashboard -> Rotate Secret.
AGENT_GAMES_HMAC_SECRET=

# Optional: Kurier mainnet API key (signup at https://kurier.xyz).
# If unset, proofs are still generated and returned, but not submitted to zkVerify.
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1

# Optional overrides
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# KURIER_POLL_BUDGET_MS=15000
# TASK_SOFT_DEADLINE_MS=50000
# SEEN_STORE_PATH=./data/seen.json
# CIRCUITS_DIR=../circuits
# PORT=8787
